# Copy to .env for local runs. Every line is optional; blanks use the fallbacks in CLAUDE.md.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
DATABASE_URL=                 # Postgres URL; blank = SQLite file in ./var
NEON_API_KEY=
EMAIL_PROVIDER=resend         # resend | smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=                   # blank = Freshroots Planning <onboarding@resend.dev>
EMAIL_TO_RAGHAV=
EMAIL_TO_PROCUREMENT=
EMAIL_TO_DEEPA=
APP_URL=                      # public dashboard URL used in email links
SECRET_KEY=                   # signs login cookies
CRON_SECRET=                  # protects /api/cron/*; Vercel Cron sends it automatically
VERCEL_TOKEN=
DATA_SOURCE_URL=              # blank = ./data; or https://..., s3://..., sftp://..., file://...
DATA_SOURCE_CREDENTIALS=
ZOHO_ENABLED=false
DASHBOARD_USERS=              # email:password,email:password; blank = generated and emailed
